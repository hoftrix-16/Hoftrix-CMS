# Production backend — copy to backend/.env on your server
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/hoftrix_db
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
DEFAULT_EMPLOYEE_PASSWORD=REPLACE_WITH_STRONG_DEFAULT_PASSWORD
CORS_ORIGIN=https://crm.hoftrix.com,https://www.hoftrix.com
API_PUBLIC_URL=https://api.hoftrix.com
FRONTEND_URL=https://crm.hoftrix.com
SERVE_FRONTEND=true

# SMTP for password reset emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Hoftrix CRM <noreply@hoftrix.com>

ADMIN_EMAIL=admin@hoftrix.com
ADMIN_PASSWORD=REPLACE_ON_FIRST_SEED_ONLY
ADMIN_NAME=Hoftrix Admin
ADMIN_PHONE=7889356866
