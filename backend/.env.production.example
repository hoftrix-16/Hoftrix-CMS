# Production backend — copy to backend/.env on api.hoftrix.com server
NODE_ENV=production
PORT=5000
HOST=0.0.0.0
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/hoftrix_db?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
DEFAULT_EMPLOYEE_PASSWORD=WELCOME
CORS_ORIGIN=https://admin.hoftrix.com,https://www.hoftrix.com
API_PUBLIC_URL=https://api.hoftrix.com
FRONTEND_URL=https://admin.hoftrix.com
SERVE_FRONTEND=false

# SMTP for password reset emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Hoftrix CRM <noreply@hoftrix.com>

ADMIN_EMAIL=hoftrix16@gmail.com
ADMIN_PASSWORD=REPLACE_ON_FIRST_SEED_ONLY
ADMIN_NAME=Hoftrix Admin
ADMIN_PHONE=7889356866
